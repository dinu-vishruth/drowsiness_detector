[Unit]
Description=Drowsiness Detector Flask App
After=network.target

[Service]
WorkingDirectory=/home/ubuntu/drowiness_detector
Environment=PORT=80
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/drowiness_detector/venv/bin/python /home/ubuntu/drowiness_detector/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
